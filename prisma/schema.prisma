generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  phone     String?
  role      String   @default("farmer")
  district  String?
  createdAt DateTime @default(now())
}